  <widget type="group" version="3.0.0">
    <name>Cryo-VisuState</name>
    <macros>
      <PV>CstatV-Ctrl:SQ:VisuState</PV>
      <TITLE>Insert</TITLE>
    </macros>
    <x>10</x>
    <y>70</y>
    <width>310</width>
    <height>80</height>
    <style>3</style>
    <transparent>true</transparent>
    <widget type="multi_state_led" version="2.0.0">
      <name>LED (Multi State)_3</name>
      <pv_name>$(PV)</pv_name>
      <width>311</width>
      <height>80</height>
      <font>
        <font name="HUGE-MONO-BOLD" family="Source Code Pro" style="BOLD" size="36.0">
        </font>
      </font>
      <square>true</square>
      <states>
        <state>
          <value>3</value>
          <label></label>
          <color>
            <color red="0" green="255" blue="0">
            </color>
          </color>
        </state>
        <state>
          <value>1</value>
          <label>                          NotRunning</label>
          <color>
            <color red="255" green="0" blue="0">
            </color>
          </color>
        </state>
        <state>
          <value>2</value>
          <label>                          Standby</label>
          <color>
            <color red="0" green="0" blue="255">
            </color>
          </color>
        </state>
      </states>
      <fallback_label>                          Err</fallback_label>
    </widget>
