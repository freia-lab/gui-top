      <states>
        <state>
          <value>3</value>
          <label></label>
          <color>
            <color red="0" green="255" blue="0">
            </color>
          </color>
        </state>
        <state>
          <value>1</value>
          <label>                          NotRunning</label>
          <color>
            <color red="255" green="0" blue="0">
            </color>
          </color>
        </state>
        <state>
          <value>2</value>
          <label>                          Standby</label>
          <color>
            <color red="0" green="0" blue="255">
            </color>
          </color>
        </state>
      </states>
      <fallback_label>                          Err</fallback_label>
